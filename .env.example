# ============================================================================
# SWIGGY AUTOMATION BOT - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================================

# ============================================================================
# 🔐 TELEGRAM BOT CONFIGURATION (Required)
# ============================================================================

# Your Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Admin user IDs (comma-separated) - Only these users can use admin commands
# Example: 123456789,987654321
ADMIN_IDS=123456789,987654321

# Admin notification channel ID (optional)
# Use @getidsbot in Telegram to get channel ID
ADMIN_CHANNEL_ID=0

# Force users to join this channel to use bot (optional)
# Set to channel ID to enable, 0 to disable
FORCE_CHANNEL_ID=0

# ============================================================================
# 🗄️ DATABASE CONFIGURATION (Required)
# ============================================================================

# MongoDB connection URI
# Format: mongodb://username:password@host:port/database
# Railway will provide this automatically, or use MongoDB Atlas
# Local: mongodb://localhost:27017/swiggy_bot
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/swiggy_bot
MONGODB_URI=mongodb://localhost:27017/swiggy_bot

# ============================================================================
# 🌐 API CONFIGURATION
# ============================================================================

# Backend API base URL (for future API integrations)
API_BASE_URL=http://localhost:5000

# API request timeout in seconds
API_TIMEOUT=120

# Maximum retries for API calls
MAX_RETRIES=3

# ============================================================================
# 💾 REDIS CONFIGURATION (Optional)
# ============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis host and port (used if REDIS_URL not set)
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis password (if required)
REDIS_PASSWORD=

# ============================================================================
# ⚙️ BOT CONFIGURATION
# ============================================================================

# Maximum concurrent users the bot can handle
MAX_CONCURRENT_USERS=500

# Session timeout in seconds (1 hour)
SESSION_TIMEOUT=3600

# Bot health check interval in seconds (5 minutes)
BOT_CHECK_INTERVAL=300

# Background task intervals (in seconds)
BUZZ_INTERVAL=3600        # 1 hour
CHECK_INTERVAL=600        # 10 minutes
AUTOMATION_CHECK_INTERVAL=300  # 5 

# Rate limiting configuration
RATE_LIMIT_REQUESTS=100   # Requests per time window
RATE_LIMIT_WINDOW=60      # Time window in seconds

# Webhook configuration (optional)
WEBHOOK_SECRET=webhook_secret_key_change_me
WEBHOOK_URL=

#
# 🚀 ENVIRONMENT & DEPLOYMENT
# ============================================================================

# Environment: production, staging, development
ENVIRONMENT=production

# Enable debug mode (set to false in production)
DEBUG=false

# Node environment variable (for compatibility)
NODE_ENV=production

# Railway specific variables (set automatically)
RAILWAY_ENVIRONMENT_NAME=production
RAILWAY_DEPLOYMENT_ID=

# ============================================================================
# ✨ FEATURE FLAGS
# ============================================================================

# Enable/disable user notifications
ENABLE_NOTIFICATIONS=true

# Enable/disable data export for admins
ENABLE_EXPORT=true

# Enable/disable admin control panel
ENABLE_ADMIN_PANEL=true

# Enable/disable forced channel subscription check
ENABLE_CHANNEL_CHECK=true

# ============================================================================
# INSTALLATION INSTRUCTIONS
# ============================================================================
#
# 1. TELEGRAM BOT SETUP
#    - Message @BotFather on Telegram
#    - Create new bot: /newbot
#    - Copy the token to TELEGRAM_TOKEN
#    - Get your Telegram ID: Use @getidsbot bot
#    - Add your ID to ADMIN_IDS
#
# 2. MONGODB SETUP
#    Option A: Local MongoDB
#      - Install MongoDB locally
#      - Run: mongod
#      - Set MONGODB_URI=mongodb://localhost:27017/swiggy_bot
#    
#    Option B: MongoDB Atlas (Cloud)
#      - Go to https://www.mongodb.com/cloud/atlas
#      - Create free account
#      - Create cluster
#      - Copy connection string to MONGODB_URI
#
# 3. RAILWAY DEPLOYMENT
#    - Go to https://railway.app
#    - Create new project
#    - Connect GitHub repository
#    - Add environment variables below
#    - Deploy!
#
# 4. ADMIN SETUP
#    - Get channel ID: Use @getidsbot
#    - Add to ADMIN_CHANNEL_ID for notifications
#    - Add to FORCE_CHANNEL_ID to require subscription
#
# ============================================================================
